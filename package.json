{
  "name": "cosmopolitan-vscode",
  "displayName": "Cosmopolitan C/C++",
  "description": "Automatically install Cosmopolitan and configure C/C++ workspaces to build with cosmocc.",
  "version": "0.0.1",
  "publisher": "tinylittle-us",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/TinyLittle-Us/cosmopolitan-vscode.git"
  },
  "files": [
    "out/**/*.js",
    "node_modules/jsonc-parser/package.json",
    "node_modules/jsonc-parser/lib/umd/**/*.js",
    "node_modules/yauzl/package.json",
    "node_modules/yauzl/*.js",
    "node_modules/pend/package.json",
    "node_modules/pend/index.js",
    "README.md",
    "LICENSE",
    "cosmopolitan-vscode-banner.webp"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "ms-vscode.cpptools"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cosmopolitan.setup",
        "title": "Cosmopolitan: Install Toolchain and Configure Workspace"
      },
      {
        "command": "cosmopolitan.launch",
        "title": "Cosmopolitan: Launch Workspace"
      }
    ],
    "configuration": {
      "title": "Cosmopolitan",
      "properties": {
        "cosmopolitan.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to override the GDB executable installed or discovered by setup."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "cosmopolitan",
        "required": [
          "workspaceFolder"
        ],
        "properties": {
          "workspaceFolder": {
            "type": "string",
            "description": "Workspace folder this Cosmopolitan build task belongs to."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@types/yauzl": "^2.10.3",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.5.3"
  }
}
